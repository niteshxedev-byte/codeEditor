# Database
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/code_editor

# Server
PORT=3001
JWT_SECRET=your_jwt_secret_key_here
SESSION_SECRET=your_session_secret_key_here
# Set COOKIE_SECURE=true only if serving via HTTPS / SSL domain. Set to false for HTTP / Docker LAN IP.
COOKIE_SECURE=false

# Codebox Sandboxed Execution Engine (Remote API)
CODEBOX_URL=https://codeeditorengine.niteshxe.dev
CODEBOX_AUTH_TOKEN=dev-token
PUBLIC_URL=https://codeeditor.niteshxe.dev
SITE_TITLE=Personal Code Editor

# AI Providers (Groq & OpenRouter)
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Local Ollama AI Endpoint (Optional local fallback)
LOCAL_OLLAMA_URL=http://localhost:11434
