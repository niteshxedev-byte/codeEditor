# Database
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/code_editor

# Server
PORT=3001
JWT_SECRET=your_jwt_secret_key_here
SESSION_SECRET=your_session_secret_key_here
# Set COOKIE_SECURE=true only if serving via HTTPS / SSL domain. Set to false for HTTP / Docker LAN IP.
COOKIE_SECURE=false

# Code Execution Sandbox (Codebox - https://github.com/hiteshchoudhary/Codebox)
# Isolated container/microVM sandbox execution engine.
CODEBOX_URL=http://localhost:3000
CODEBOX_AUTH_TOKEN=dev-token

# Ollama AI Endpoint (Cloud API)
OLLAMA_URL=https://ollama.com
OLLAMA_API_KEY=your_ollama_cloud_api_key_here

# Local Ollama override (optional, used in Docker or local dev)
LOCAL_OLLAMA_URL=http://localhost:11434
