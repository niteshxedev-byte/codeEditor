<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Code Editor — Personal Code Editor</title>

  <!-- Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css" />
  <link href="https://cdn.jsdelivr.net/npm/remixicon@4.5.0/fonts/remixicon.css" rel="stylesheet" />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Space+Grotesk:wght@400;500;600&display=swap"
    rel="stylesheet" />

  <!-- JSZip -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
  <!-- jsPDF -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

  <!-- Socket.IO loaded BEFORE Monaco loader to prevent AMD loader collision -->
  <script src="/socket.io/socket.io.js"></script>
  <script>
    if (typeof io === 'undefined') {
      document.write('<script src="https://cdn.socket.io/4.8.1/socket.io.min.js"><\/script>');
    }
  </script>

  <!-- Monaco Editor Loader -->
  <script>
    var require = {
      paths: {
        vs: "https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.38.0/min/vs",
      },
    };
  </script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.38.0/min/vs/loader.js"></script>

  <!-- Clean Theme Stylesheet -->
  <link rel="stylesheet" href="/style_codeeditor.css?v=5" />

  <style>
    /* Panel visibility helper — driven by the Ctrl+B / Ctrl+M / Ctrl+` toggles */
    .pce-hidden {
      display: none !important;
    }
  </style>
</head>

<body>
  <!-- Header Bar -->
  <header class="editor-header">
    <div class="brand-section">
      <a href="/DashboardCodeEditor" class="editor-title" title="Return to Dashboard">
        <i class="ri-terminal-box-line"></i>
        <span>pce/editor</span>
      </a>
      <span class="workspace-badge">workspace-1</span>
    </div>

    <div class="header-controls">
      <!-- Language Selector -->
      <select class="select-box" id="language" title="Programming Language">
        <option value="">Select Language</option>
        <% if (typeof languages !=="undefined" && languages.length> 0) { %>
          <% languages.forEach(lang=> { %>
            <option value="<%= lang.id %>" <%=lang.id===1 ? "selected" : "" %>>
              <%= lang.name %>
            </option>
            <% }) %>
              <% } else { %>
                <option value="1" selected>JavaScript (Node.js)</option>
                <option value="2">TypeScript (ts-node)</option>
                <option value="3">Python (python3)</option>
                <option value="4">C++ (GCC, C++17)</option>
                <option value="5">C (GCC)</option>
                <option value="6">Java (OpenJDK)</option>
                <option value="7">Rust (rustc)</option>
                <option value="8">Go (go run)</option>
                <option value="10">PHP (php)</option>
                <option value="11">Ruby (ruby)</option>
                <option value="14">SQL (SQLite)</option>
                <option value="15">Bash</option>
                <% } %>
      </select>

      <button onclick="addFile()" class="btn-tool" title="Add File (Ctrl+N)">
        <i class="ri-file-add-line"></i> <span>File</span>
      </button>
      <button onclick="addFolder()" class="btn-tool" title="Add Folder (Shift+Ctrl+N)">
        <i class="ri-folder-add-line"></i> <span>Folder</span>
      </button>
      <button onclick="formatCode()" class="btn-tool" title="Format Code (Shift+Ctrl+F)">
        <i class="ri-magic-line"></i> <span>Format</span>
      </button>
      <button onclick="runCode()" class="btn-tool btn-primary" title="Execute Code (Ctrl+Enter)">
        <i class="ri-play-fill"></i> <span>Run</span>
      </button>

      <button onclick="exportFolder()" class="btn-tool" title="Export as ZIP">
        <i class="ri-download-2-line"></i>
      </button>
      <button onclick="importFolder()" class="btn-tool" title="Open Project Folder / Files (Shift+Ctrl+O)">
        <i class="ri-folder-open-line"></i> <span>Open</span>
      </button>
      <button onclick="saveWorkspaceToMongoDB(false)" class="btn-tool" title="Save Workspace to DB (Ctrl+S)">
        <i class="ri-cloud-upload-line"></i> <span>Save</span>
      </button>
      <button onclick="saveWorkspaceToMongoDB(true)" class="btn-tool" title="Save Workspace As New (Shift+Ctrl+S)">
        <i class="ri-save-3-line"></i> <span>Save As</span>
      </button>
      <button onclick="exportToPDF()" class="btn-tool" title="Export Code as PDF">
        <i class="ri-file-pdf-line"></i> <span>PDF</span>
      </button>
      <button onclick="openHtmlPreview()" class="btn-tool" title="Preview HTML in browser tab" id="btn-preview">
        <i class="ri-eye-line"></i> <span>Preview</span>
      </button>

      <span class="font-size-control">
        <span>size:</span>
        <input type="number" id="fontSize" value="15" min="10" max="32" onchange="updateFontSize()" />
      </span>

      <a href="/DashboardCodeEditor" class="btn-tool" title="Saved Workspaces & Documents (Ctrl+D)">
        <i class="ri-folder-cloud-line"></i> <span>Workspaces</span>
      </a>

      <a href="/DashboardCodeEditor?action=switch-user" id="btn-switch-user" class="btn-tool"
        style="color:#a1a1aa; text-decoration:none; display:flex; align-items:center; gap:4px;"
        title="Switch User Profile">
        <i class="ri-user-shared-line"></i> <span>User</span>
      </a>

      <a href="/logout" id="btn-exit" class="btn-tool"
        style="color:#ef4444; text-decoration:none; display:flex; align-items:center; gap:4px;"
        title="Exit Application">
        <i class="ri-logout-box-r-line"></i> <span>Exit</span>
      </a>
    </div>
  </header>

  <!-- Main Container -->
  <div class="container">
    <!-- File Explorer (Ctrl+B toggles) -->
    <div id="file-explorer" class="pce-hidden">
      <div class="panel-title" style="display:flex; align-items:center; justify-content:space-between;">
        <div style="display:flex; align-items:center; gap:6px;">
          <span>Explorer</span>
          <i class="ri-folders-line" style="color:var(--text-muted); font-size:13px;"></i>
        </div>
        <div class="explorer-quick-actions" style="display:flex; align-items:center; gap:2px;">
          <button type="button" onclick="addFile()" class="btn-icon" title="New File (Ctrl+N)">
            <i class="ri-file-add-line"></i>
          </button>
          <button type="button" onclick="addFolder()" class="btn-icon" title="New Folder (Shift+Ctrl+N)">
            <i class="ri-folder-add-line"></i>
          </button>
          <button type="button" onclick="importFolder()" class="btn-icon" title="Open Folder / Files (Shift+Ctrl+O)">
            <i class="ri-folder-open-line"></i>
          </button>
        </div>
      </div>
      <div id="file-tree-container" class="file-tree-container">
        <div class="tree-file-item active">
          <i class="ri-javascript-line" style="color:#eab308"></i>
          <span>main.js</span>
        </div>
        <div class="tree-file-item">
          <i class="ri-file-text-line" style="color:#60a5fa"></i>
          <span>README.md</span>
        </div>
      </div>
    </div>

    <!-- Center Monaco Editor -->
    <div id="editor-container">
      <div class="editor-tabs-bar">
        <div class="editor-tab active">
          <i class="ri-code-line" style="color:#2563eb"></i>
          <span>main.js</span>
        </div>
      </div>
      <div id="editor"></div>
    </div>

    <!-- Right AI Assistant (Ctrl+M toggles) -->
    <div id="console-wrapper" class="pce-hidden">
      <div class="console-header">
        <span class="console-title">
          <i class="ri-sparkling-line" style="color:#2563eb"></i> Teacher Agent
        </span>
        <div style="display:flex; align-items:center; gap:6px;">
          <select id="ai-model-select" class="select-box"
            style="height:24px; font-size:11px; padding:0 6px; width:auto; max-width:160px; background:#000; border-color:#27272a; color:#fff;"
            title="Select Local or Cloud Ollama Model">
            <% if (typeof aiModels !=="undefined" && aiModels.length> 0) { %>
              <% aiModels.forEach((m, idx)=> { %>
                <option value="<%= m.id %>" <%=idx===0 ? "selected" : "" %>>
                  <%= m.name %>
                </option>
                <% }) %>
                  <% } else { %>
                    <option value="llama3.2:1b" selected>llama3.2:1b (Local)</option>
                    <option value="qwen3.5:0.8b">qwen3.5:0.8b (Local)</option>
                    <option value="gemma4:31b">gemma4:31b (Cloud - Free)</option>
                    <option value="gpt-oss:20b">gpt-oss:20b (Cloud - Free)</option>
                    <% } %>
          </select>
          <button type="button" onclick="refreshModels()"
            style="background:none; border:none; color:#6b7280; cursor:pointer; padding:2px; font-size:12px;"
            title="Refresh local & cloud models">
            <i class="ri-refresh-line"></i>
          </button>
          <span style="font-size: 10px; font-family: 'JetBrains Mono', monospace; color:#22c55e;">
            ●
          </span>
        </div>
      </div>

      <div id="console-output" class="output_ai">
        <div class="chat-bubble-agent">
          <strong>Agent ready.</strong>
          <p style="margin-top: 4px; color: #a1a1aa;">
            Ask questions, debug errors, or generate boilerplate code.
          </p>
        </div>
      </div>

      <!-- Fixed: single form, no nested forms, no nested buttons -->
      <form id="prompt" autocomplete="off">
        <input type="text" name="prompt" id="console-input" autocomplete="off" placeholder="Ask AI agent..." />
        <label for="pdf" id="file-label" title="Attach document">
          <i class="ri-attachment-line"></i>
        </label>
        <input type="file" id="pdf" accept=".pdf" />
        <button type="submit" class="submit-btn" title="Send message">
          <i class="ri-send-plane-2-line"></i>
        </button>
      </form>
    </div>
  </div>

  <!-- Bottom Terminal Panel (Ctrl+` toggles) -->
  <div id="vscode-terminal" class="pce-hidden">
    <div class="vscode-terminal-tabs">
      <div class="terminal-tab-group">
        <span class="tab active">OUTPUT</span>
        <span class="tab">PROBLEMS</span>
        <span class="tab">DEBUG CONSOLE</span>
      </div>

      <div class="terminal-actions">
        <span id="COADING_LANGUAGE">
          <i class="ri-terminal-line"></i> JAVASCRIPT (NODE.JS)
        </span>
        <button onclick="clearConsole()" class="btn-tool" style="height:22px; padding:0 8px; font-size:11px;"
          title="Clear console">
          clear
        </button>
      </div>
    </div>

    <div id="terminal-screen">
      <div class="terminal-line terminal-dim">Terminal ready. Click Run or press Ctrl+Enter to execute.</div>
    </div>
  </div>

  <!-- Hidden Inputs -->
  <input type="file" id="folderInput" webkitdirectory style="display: none" />
  <input type="file" id="fileInput" style="display: none" />

  <!-- Prettier Formatters (Stable UMD bundles via Cloudflare cdnjs) -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/prettier/2.8.8/standalone.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/prettier/2.8.8/parser-babel.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/prettier/2.8.8/parser-html.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/prettier/2.8.8/parser-typescript.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/prettier/2.8.8/parser-postcss.min.js"></script>

  <!-- Native IDE Form Dialog (Replaces browser prompts/alerts) -->
  <dialog id="ide-modal-dialog" class="ide-modal-dialog">
    <div class="ide-dialog-card">
      <div class="ide-dialog-header">
        <div class="ide-dialog-title-group">
          <i id="ide-dialog-icon" class="ri-terminal-box-line"></i>
          <h3 id="ide-dialog-title">Dialog</h3>
        </div>
        <button type="button" class="ide-dialog-close" id="ide-dialog-close-btn" aria-label="Close dialog">
          <i class="ri-close-line"></i>
        </button>
      </div>

      <p id="ide-dialog-subtitle" class="ide-dialog-subtitle"></p>

      <form id="ide-dialog-form" autocomplete="off">
        <div id="ide-dialog-fields" class="ide-dialog-fields">
          <!-- Dynamically populated fields -->
        </div>

        <div id="ide-dialog-error" class="pce-hidden ide-dialog-error" role="alert"></div>

        <div class="ide-dialog-actions">
          <button type="button" id="ide-dialog-cancel-btn" class="ide-btn ide-btn-secondary">
            Cancel
          </button>
          <button type="button" id="ide-dialog-submit-btn" class="ide-btn ide-btn-primary">
            Confirm
          </button>
        </div>
      </form>
    </div>
  </dialog>

  <!-- Non-blocking IDE Toast Notifications -->
  <div id="ide-toast-container" class="ide-toast-container" aria-live="polite"></div>

  <!-- Editor Core Logic & In-App Dialog System -->
  <script src="/editor.js?v=5"></script>
  <!-- Editor Toolbar, Code Execution, AI Streaming, & Workspace Exports -->
  <script src="/editor_actions.js?v=5" defer></script>
</body>

</html>