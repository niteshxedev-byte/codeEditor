<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Log in — Personal Code Editor</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
        rel="stylesheet">

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        void: '#000000',
                        surface: '#0D0D0D',
                        edge: '#1F1F1F',
                        blue: '#2563EB',
                        snow: '#FFFFFF',
                        muted: '#6B7280',
                        danger: '#EF4444',
                        ok: '#22C55E',
                    },
                    fontFamily: {
                        sans: ['Space Grotesk', 'system-ui', 'sans-serif'],
                        mono: ['"JetBrains Mono"', 'ui-monospace', 'monospace'],
                    },
                }
            }
        }
    </script>

    <!-- GSAP -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" crossorigin="anonymous"></script>

    <style>
        html,
        body {
            height: 100%;
        }

        body {
            overflow-x: hidden;
        }

        /* Input focus ring */
        input:focus {
            outline: none;
            border-color: #2563EB;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
        }

        /* Remove autofill yellow flash */
        input:-webkit-autofill,
        input:-webkit-autofill:focus {
            transition: background-color 0s 600000s, color 0s 600000s;
        }

        .pw-toggle {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            cursor: pointer;
            color: #6B7280;
            padding: 4px;
            line-height: 1;
        }

        .pw-toggle:hover {
            color: #FFFFFF;
        }

        :focus-visible {
            outline: 2px solid #2563EB;
            outline-offset: 3px;
            border-radius: 2px;
        }

        @media (prefers-reduced-motion: reduce) {
            .form-wrap {
                opacity: 1 !important;
                transform: none !important;
            }
        }
    </style>
</head>

<body class="flex flex-col bg-void min-h-screen font-sans text-snow antialiased">

    <!-- ─── Nav ──────────────────────────────────────────────────────── -->
    <nav class="flex justify-between items-center px-6 border-edge border-b h-14">
        <a href="/" class="hover:opacity-80 font-mono text-blue text-sm tracking-tight transition-opacity">
            niteshxe.dev/
        </a>
        <a href="/register" class="font-mono text-muted hover:text-snow text-xs transition-colors">
            create account
        </a>
    </nav>


    <!-- ─── Form ─────────────────────────────────────────────────────── -->
    <main class="flex flex-1 justify-center items-center px-6 py-16">
        <div class="w-full max-w-sm form-wrap" style="opacity:0">

            <div class="mb-10">
                <h1 class="mb-2 font-medium text-snow text-2xl">Welcome back</h1>
                <p class="text-muted text-sm">Log in to open your editor.</p>
            </div>

            <!-- Error flash — Express passes `error` from res.render() -->
            <% if (typeof error !=='undefined' && error) { %>
                <div class="bg-danger/10 mb-6 px-4 py-3 border border-danger/40 rounded-sm text-danger text-sm">
                    <%= error %>
                </div>
                <% } %>

                    <!-- Success flash — Express passes `success` from res.render() -->
                    <% if (typeof success !=='undefined' && success) { %>
                        <div class="bg-ok/10 mb-6 px-4 py-3 border border-ok/40 rounded-sm text-ok text-sm">
                            <%= success %>
                        </div>
                        <% } %>



                            <form action="/login" method="POST" novalidate class="space-y-5">

                                <!-- Email -->
                                <div class="space-y-1.5">
                                    <label for="email" class="block font-mono text-muted text-xs">email</label>
                                    <input id="email" name="email" type="email" autocomplete="email" required
                                        placeholder="you@example.com"
                                        value="<%= typeof formData !== 'undefined' ? formData.email : '' %>"
                                        class="bg-surface px-4 py-2.5 border border-edge rounded-sm w-full text-snow text-sm transition-colors placeholder-muted/50">
                                </div>

                                <!-- Password -->
                                <div class="space-y-1.5">
                                    <div class="flex justify-between items-center">
                                        <label for="password"
                                            class="block font-mono text-muted text-xs">password</label>
                                        <a href="/forgot-password"
                                            class="font-mono text-muted hover:text-snow text-xs transition-colors">forgot?</a>
                                    </div>
                                    <div class="relative">
                                        <input id="password" name="password" type="password"
                                            autocomplete="current-password" required placeholder="••••••••"
                                            class="bg-surface px-4 py-2.5 pr-10 border border-edge rounded-sm w-full text-snow text-sm transition-colors placeholder-muted/50">
                                        <button type="button" class="pw-toggle" aria-label="Show password" id="pw-btn">
                                            <!-- Eye open -->
                                            <svg id="icon-show" xmlns="http://www.w3.org/2000/svg" width="16"
                                                height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                                                stroke-width="1.75">
                                                <path stroke-linecap="round" stroke-linejoin="round"
                                                    d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
                                                <path stroke-linecap="round" stroke-linejoin="round"
                                                    d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                                            </svg>
                                            <!-- Eye closed -->
                                            <svg id="icon-hide" xmlns="http://www.w3.org/2000/svg" width="16"
                                                height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                                                stroke-width="1.75" class="hidden">
                                                <path stroke-linecap="round" stroke-linejoin="round"
                                                    d="M3.98 8.223A10.477 10.477 0 0 0 1.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.451 10.451 0 0 1 12 4.5c4.756 0 8.773 3.162 10.065 7.498a10.522 10.522 0 0 1-4.293 5.774M6.228 6.228 3 3m3.228 3.228 3.65 3.65m7.894 7.894L21 21m-3.228-3.228-3.65-3.65m0 0a3 3 0 1 0-4.243-4.243m4.242 4.242L9.88 9.88" />
                                            </svg>
                                        </button>
                                    </div>
                                </div>

                                <!-- Submit -->
                                <button type="submit"
                                    class="bg-blue hover:bg-blue/90 mt-2 py-2.5 rounded-sm w-full font-mono text-white text-sm active:scale-[0.99] transition-all">
                                    Log in
                                </button>

                            </form>

                            <p class="mt-8 font-mono text-muted text-xs text-center">
                                No account?
                                <a href="/register" class="ml-1 text-snow hover:text-blue transition-colors">Create
                                    one</a>
                            </p>

        </div>
    </main>


    <!-- ─── Footer ───────────────────────────────────────────────────── -->
    <footer class="px-6 py-5 border-edge border-t">
        <p class="font-mono text-muted/40 text-xs text-center">
            personal_code_editor — built on open-source
        </p>
    </footer>


    <script>
        // ─── Fade-in ──────────────────────────────────────────────────────
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!reduced) {
            gsap.fromTo('.form-wrap',
                { opacity: 0, y: 14 },
                { opacity: 1, y: 0, duration: 0.45, ease: 'power2.out', delay: 0.1 }
            );
        } else {
            document.querySelector('.form-wrap').style.opacity = '1';
        }

        // ─── Show / hide password ─────────────────────────────────────────
        const pwInput = document.getElementById('password');
        const pwBtn = document.getElementById('pw-btn');
        const iconShow = document.getElementById('icon-show');
        const iconHide = document.getElementById('icon-hide');

        pwBtn.addEventListener('click', () => {
            const visible = pwInput.type === 'text';
            pwInput.type = visible ? 'password' : 'text';
            pwBtn.setAttribute('aria-label', visible ? 'Show password' : 'Hide password');
            iconShow.classList.toggle('hidden', !visible);
            iconHide.classList.toggle('hidden', visible);
        });


    </script>

</body>

</html>