                    <div class="feature-card">
                        <div class="feature-header">
                            <h3 class="feature-title">Per-IP Rate Limiting</h3>
                            <div class="feature-icon-badge">🛡️</div>
                        </div>
                        <p class="feature-desc">
                            Hardened security perimeter with IP-based and user-based sliding-window rate limiters
                            protecting authentication routes, code execution, and AI queries.
                        </p>
                        <div class="feature-meta">
                            <span class="tech-pill">express-rate-limit</span>
                            <span class="tech-pill">Brute-Force Guard</span>
                            <span class="tech-pill">HTTP 429</span>
                        </div>
                    </div>

                    <div class="feature-card">
                        <div class="feature-header">
                            <h3 class="feature-title">Zip & PDF Export Engine</h3>
                            <div class="feature-icon-badge">📁</div>
                        </div>
                        <p class="feature-desc">
                            Download complete workspaces as standard zip archives or generate styled PDF code reports
                            with strict path traversal containment checks.
                        </p>
                        <div class="feature-meta">
                            <span class="tech-pill">PDFKit</span>
                            <span class="tech-pill">Archiver</span>
                            <span class="tech-pill">Owner-Only</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>



        <!-- ─── Call to Action ────────────────────────────────────────────────── -->
        <section class="section-block">
            <div class="container">
                <div class="cta-banner">
                    <div>
                        <h2 class="cta-heading">Ready to build and test code?</h2>
                        <p class="cta-text">
                            Launch an instant editing session, open your existing projects, or explore the API.
                        </p>
                    </div>

                    <div class="cta-buttons">
                        <a href="/editor" class="btn-primary" style="padding: 10px 22px; font-size: 13px;">
                            Launch Editor →
                        </a>
                        <% if (typeof user !=='undefined' && user) { %>
                            <a href="/DashboardCodeEditor" class="btn-subtle"
                                style="padding: 10px 20px; font-size: 13px;">
                                Open Dashboard
                            </a>
                            <% } else { %>
                                <a href="/login" class="btn-subtle" style="padding: 10px 20px; font-size: 13px;">
                                    Sign In
                                </a>
                                <% } %>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- ─── Site Footer ───────────────────────────────────────────────────────── -->
    <footer class="site-footer">
        <div class="container footer-inner">
            <div>personal_code_editor // open architecture</div>
            <div class="footer-links">
                <a href="/DashboardCodeEditor">dashboard</a>
                <a href="/editor">editor</a>
                <a href="/login">authentication</a>
                <a href="https://github.com/hiteshchoudhary/Codebox" target="_blank" rel="noopener noreferrer">codebox
                    repo</a>
            </div>
        </div>
    </footer>

    <!-- ─── Interactive Architecture Script (No External Dependencies) ───────── -->
    <script>
        (function () {
            // Architecture Content Dictionary
            const ARCHITECTURE_DATA = {
                sandbox: {
                    badge: "Execution Engine (Codebox)",
                    title: "Container & MicroVM Sandbox Isolation",
                    body: "Replaced host child_process execution with isolated Codebox containers. Submissions are dispatched synchronously via REST API with strict timeouts, zero local filesystem exposure, and no environment variable leakage.",
                    code: `// Express Codebox Adapter Dispatch\nPOST \${CODEBOX_URL}/submissions?wait=true\nHeaders: { "X-Auth-Token": CODEBOX_AUTH_TOKEN }\nBody: {\n  "source_code": code,\n  "language_id": codeboxLangId,\n  "stdin": stdin\n}\n// Executed in container with --network none & cgroup limits`
                },
                ai: {
                    badge: "Intelligence Layer (LangChain & Ollama)",
                    title: "Hybrid Dual-Engine AI Assistant",
                    body: "The AI assistant dynamically routes queries between local Ollama instances (for offline, private, zero-cost execution) and cloud providers. Employs LangGraph to handle file creation and workspace inspection tools.",
                    code: `// WebSocket Streaming AI Pipeline\nio.on('connection', (socket) => {\n  socket.on('ask-ai', async ({ prompt, model, fileSystem }) => {\n    // Rate check: 20 req/min per user\n    checkAiSocketRateLimit(socket.user.userId);\n    await runTeacherAgent({ prompt, emitter, modelName });\n  });\n});`
                },
                editor: {
                    badge: "Editor Core (Monaco 0.52)",
                    title: "Multi-Buffer File Workspace",
                    body: "Uses Monaco Editor's native text model buffer switching to maintain instant file transitions without memory re-allocations. Features auto-saving with debounced persistence to MongoDB.",
                    code: `// Model Buffer Switch Pattern\nfunction switchToFile(fileId) {\n  const file = fileSystem.find(f => f.id === fileId);\n  editor.setModel(models[file.id]);\n  syncLanguageDropdown(file.name);\n  triggerAutoSave(600);\n}`
                },
                security: {
                    badge: "Perimeter Security & Auth",
                    title: "Defense-in-Depth Protection",
                    body: "Hardened perimeter featuring bcrypt-hashed passwords, signed 7-day HTTP-only JWT session cookies, path containment validation on uploads, and rate limiting across login, register, and AI endpoints.",
                    code: `// Layered Security Stack\nrouter.post('/login', loginRateLimiter, loginController);\nrouter.post('/register', registerRateLimiter, registerController);\nrouter.post('/runCode', authenticate, codeLimiter, runCode);\nrouter.post('/ask-ai', authenticate, aiRateLimiter, askAi);`
                }
            };

            const tabButtons = document.querySelectorAll('.tab-btn');
            const displayPane = document.getElementById('inspector-display');

            function renderPane(key) {
                const item = ARCHITECTURE_DATA[key];
                if (!item || !displayPane) return;

                displayPane.innerHTML = `
                    <div class="inspector-badge">${item.badge}</div>
                    <h3 class="inspector-headline">${item.title}</h3>
                    <p class="inspector-body">${item.body}</p>
                    <pre class="code-snippet"><code>${escapeHtml(item.code)}</code></pre>
                `;
            }

            function escapeHtml(str) {
                return str
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#039;');
            }

            tabButtons.forEach(btn => {
                btn.addEventListener('click', () => {
                    tabButtons.forEach(b => {
                        b.classList.remove('active');
                        b.setAttribute('aria-selected', 'false');
                    });

                    btn.classList.add('active');
                    btn.setAttribute('aria-selected', 'true');

                    const target = btn.getAttribute('data-target');
                    renderPane(target);
                });
            });

            // Initial render
            renderPane('sandbox');
        })();

        // Architecture Diagram Toggle Data
        const DIAGRAM_DATA = {
            execution: {
                filename: "codebox-pipeline.ascii",
                text: `+---------------------+      +---------------+      +---------------+      +-----------+
|  ChaiCode Frontend  | ───▶ |  CodeBox API  | ───▶ |  Redis Queue  | ───▶ |  Workers  |
+---------------------+      +---------------+      +---------------+      +─────┬─────+
                                                                                 │
                                     ┌───────────────────────────────────────────┴───────────────────────────────────────────┐
                                     │                                                                                       │
                                     ▼                                                                                       ▼
                         ┌───────────────────────┐                                                               ┌───────────────────────┐
                         │ Firecracker (microVM) │                                  OR                           │  Docker (container)   │
                         └───────────┬───────────┘                                                               └───────────┬───────────┘
                                     │                                                                                       │
                                     └───────────────────────────────────────────┬───────────────────────────────────────────┘
                                                                                 │
                                                                                 ▼
                                                             ┌───────────────────────────────────────┐
                                                             │       Sandboxed Code Execution        │
                                                             │        (isolated, time-limited)       │
                                                             └───────────────────────────────────────┘`
            },
            system: {
                filename: "pce-system-architecture.ascii",
                text: `┌─────────────────────────────────────────────────────────────────────────────────────────────────┐
│                             BROWSER CLIENT: PERSONAL CODE EDITOR (PCE)                          │
│  ┌─────────────────────────┐   ┌────────────────────────┐   ┌────────────────────────────────┐  │
│  │   Monaco Code Editor    │   │  Virtual File System   │   │    Teacher Agent AI Console    │  │
│  │ (Multi-Buffer Buffers)  │   │(Debounced LocalStorage)│   │ (Socket.IO Real-Time Stream)   │  │
│  └────────────┬────────────┘   └───────────┬────────────┘   └───────────────┬────────────────┘  │
└───────────────┼────────────────────────────┼────────────────────────────────┼───────────────────┘
                │ HTTP POST /runCode         │ Sync /api/projects             │ WebSocket 'ask-ai'
                ▼                            ▼                                ▼
┌─────────────────────────────────────────────────────────────────────────────────────────────────┐
│                               EXPRESS.JS BACKEND SERVER (Port 3001)                             │
│ ┌─────────────────────────────────────────────────────────────────────────────────────────────┐ │
│ │ Security & Defense Layer: JWT Auth • Rate Limiters • Helmet Headers • Path Traversal Guards │ │
│ └────────────────────────────┬────────────────────────────┬───────────────────────────────────┘ │
│                              │                            │                                     │
│   ┌──────────────────────────┴───┐ ┌──────────────────────┴────┐ ┌───────────────────────────┐  │
│   │   Codebox Execution Client   │ │   Workspace Persistence   │ │     LangChain Service     │  │
│   │ (Proxy & Java Normalization) │ │    (Mongoose Controllers) │ │ (Hybrid Model Router/RAG) │  │
│   └──────────────┬───────────────┘ └──────────────┬────────────┘ └─────────────┬─────────────┘  │
└──────────────────┼────────────────────────────────┼────────────────────────────┼────────────────┘
                   │ REST (dev-token)               │ TLS Connection             │ HTTP / API Key
                   ▼                                ▼                            ▼
    ┌──────────────────────────────┐ ┌───────────────────────────┐ ┌───────────────────────────┐
    │    CODEBOX SANDBOX ENGINE    │ │      DATABASE LAYER       │ │     AI INFERENCE TIER     │
    │ ┌──────────────────────────┐ │ │  ┌─────────────────────┐  │ │ ┌───────────────────────┐ │
    │ │   Codebox REST API :3000 │ │ │  │   MongoDB Database  │  │ │ │ Local Ollama Engine   │ │
    │ └────────────┬─────────────┘ │ │  │ (Users, Projects,   │  │ │ │ (llama3.2 / qwen3.5)  │ │
    │              ▼               │ │  │  Exported PDFs)     │  │ │ └───────────────────────┘ │
    │ ┌──────────────────────────┐ │ │  └─────────────────────┘  │ │             OR            │
    │ │    Redis Job Queue       │ │ └───────────────────────────┘ │ ┌───────────────────────┐ │
    │ └────────────┬─────────────┘ │                               │ │ Cloud Ollama API      │ │
    │              ▼               │                               │ │ (gemma4 / gpt-oss)    │ │
    │ ┌──────────────────────────┐ │                               │ └───────────────────────┘ │
    │ │   Worker Execution Pool  │ │                               └───────────────────────────┘
    │ └────────────┬─────────────┘ │
    │              ▼               │
    │ ┌──────────────────────────┐ │
    │ │  Isolated Sandboxes      │ │
    │ │ (Docker / Firecracker)   │ │
    │ └──────────────────────────┘ │
    └──────────────────────────────┘`
            }
        };

        let currentDiagramMode = 'visual';

        function switchDiagram(mode) {
            currentDiagramMode = mode;
            const visualWrapper = document.getElementById("visual-arch-wrapper");
            const asciiWrapper = document.getElementById("ascii-arch-wrapper");
            const codeEl = document.getElementById("diagram-code");
            const filenameEl = document.getElementById("diagram-filename-label");
            const tabVisual = document.getElementById("tab-diag-visual");
            const tabExecution = document.getElementById("tab-diag-execution");
            const tabSystem = document.getElementById("tab-diag-system");

            [tabVisual, tabExecution, tabSystem].forEach(tab => {
                if (tab) {
                    tab.classList.remove('active');
                    tab.setAttribute('aria-selected', 'false');
                }
            });

            if (mode === 'visual') {
                if (tabVisual) {
                    tabVisual.classList.add('active');
                    tabVisual.setAttribute('aria-selected', 'true');
                }
                if (visualWrapper) visualWrapper.style.display = 'flex';
                if (asciiWrapper) asciiWrapper.style.display = 'none';
                if (filenameEl) filenameEl.textContent = 'codebox-architecture.visual';
            } else {
                const data = DIAGRAM_DATA[mode];
                if (!data) return;

                if (mode === 'execution' && tabExecution) {
                    tabExecution.classList.add('active');
                    tabExecution.setAttribute('aria-selected', 'true');
                } else if (mode === 'system' && tabSystem) {
                    tabSystem.classList.add('active');
                    tabSystem.setAttribute('aria-selected', 'true');
                }

                if (visualWrapper) visualWrapper.style.display = 'none';
                if (asciiWrapper) asciiWrapper.style.display = 'block';
                if (codeEl) codeEl.textContent = data.text;
                if (filenameEl) filenameEl.textContent = data.filename;
            }
        }
        window.switchDiagram = switchDiagram;

        // Diagram copy to clipboard helper
        function copyDiagramFlow() {
            const btnLabel = document.getElementById("copy-btn-label");
            let textToCopy = "";

            if (currentDiagramMode === 'visual' || currentDiagramMode === 'execution') {
                textToCopy = DIAGRAM_DATA.execution.text;
            } else {
                textToCopy = DIAGRAM_DATA.system.text;
            }

            navigator.clipboard.writeText(textToCopy).then(() => {
                if (btnLabel) {
                    btnLabel.textContent = "Copied!";
                    setTimeout(() => { btnLabel.textContent = "Copy Diagram"; }, 2000);
                }
            }).catch(() => {
                if (btnLabel) btnLabel.textContent = "Failed";
            });
        }
        window.copyDiagramFlow = copyDiagramFlow;
    </script>
</body>

</html>