    <!-- Interactive Inspector Script -->
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const buttons = document.querySelectorAll(".arch-btn");
            const panes = document.querySelectorAll(".arch-pane");

            buttons.forEach(btn => {
                btn.addEventListener("click", () => {
                    const target = btn.getAttribute("data-target");

                    // Reset buttons
                    buttons.forEach(b => {
                        b.classList.remove("border-accent/40", "bg-accent/10", "text-snow");
                        b.classList.add("border-transparent", "text-muted");
                        const dot = b.querySelector("span:first-child");
                        if (dot) dot.classList.replace("text-accent", "text-dim");
                    });

                    // Activate current button
                    btn.classList.add("border-accent/40", "bg-accent/10", "text-snow");
                    btn.classList.remove("border-transparent", "text-muted");
                    const activeDot = btn.querySelector("span:first-child");
                    if (activeDot) activeDot.classList.replace("text-dim", "text-accent");

                    // Switch pane
                    panes.forEach(pane => pane.classList.add("hidden"));
                    const activePane = document.getElementById("pane-" + target);
                    if (activePane) activePane.classList.remove("hidden");
                });
            });
        });
    </script>
