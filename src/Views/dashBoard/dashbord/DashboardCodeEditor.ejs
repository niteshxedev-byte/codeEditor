<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Workspace Dashboard — Personal Code Editor</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap"
        rel="stylesheet">

    <!-- Remix Icons -->
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.5.0/fonts/remixicon.css" rel="stylesheet" />

    <!-- Tailwind CDN for utility classes -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        void: '#000000',
                        surface: '#0A0A0A',
                        edge: '#1E1E1E',
                        blue: '#2563EB',
                        snow: '#FFFFFF',
                        muted: '#6B7280',
                        danger: '#EF4444',
                        ok: '#22C55E'
                    },
                    fontFamily: {
                        sans: ['"Space Grotesk"', 'system-ui', 'sans-serif'],
                        mono: ['"JetBrains Mono"', 'ui-monospace', 'monospace']
                    }
                }
            }
        }
    </script>

    <style>
        :root {
            --void: #000000;
            --surface: #0a0a0a;
            --surface-elevated: #111111;
            --edge: #1e1e1e;
            --edge-focus: #2563eb;
            --blue: #2563eb;
            --blue-hover: #1d4ed8;
            --snow: #ffffff;
            --muted: #6b7280;
            --danger: #ef4444;
            --danger-hover: #dc2626;
        }

        *,
        *::before,
        *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html,
        body {
            background-color: var(--void);
            color: var(--snow);
            font-family: 'Space Grotesk', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
        }

        /* Top Header */
        .dashboard-header {
            height: 52px;
            background-color: rgba(0, 0, 0, 0.85);
            backdrop-filter: blur(8px);
            border-bottom: 1px solid var(--edge);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 24px;
            position: sticky;
            top: 0;
            z-index: 40;
            width: 100%;
        }

        .header-brand {
            display: flex;
            align-items: center;
            gap: 8px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 13.5px;
            font-weight: 500;
            color: var(--blue);
            text-decoration: none;
            transition: opacity 0.15s ease;
        }

        .header-brand:hover {
            opacity: 0.85;
        }

        .header-controls {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .btn-launch-editor {
            background-color: var(--blue);
            color: var(--snow);
            font-family: 'JetBrains Mono', monospace;
            font-size: 12px;
            font-weight: 500;
            padding: 6px 12px;
            border-radius: 3px;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: background-color 0.15s ease;
        }

        .btn-launch-editor:hover {
            background-color: var(--blue-hover);
        }

        .header-divider {
            width: 1px;
            height: 16px;
            background-color: var(--edge);
        }

        .user-tag {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 12px;
        }

        .user-tag-label {
            color: var(--muted);
        }

        .user-tag-name {
            color: var(--snow);
            font-weight: 500;
        }

        .btn-header-exit {
            font-family: 'JetBrains Mono', monospace;
            font-size: 12px;
            color: var(--muted);
            text-decoration: none;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            transition: color 0.15s ease;
            margin-left: 4px;
        }

        .btn-header-exit:hover {
            color: var(--danger);
        }

        /* Main Container */
        .dashboard-main {
            flex: 1;
            max-width: 1280px;
            width: 100%;
            margin: 0 auto;
            padding: 32px 24px;
            display: flex;
            flex-direction: column;
            gap: 32px;
        }

        /* Welcome Banner */
        .welcome-card {
            background-color: var(--surface);
            border: 1px solid var(--edge);
            border-radius: 4px;
            padding: 24px 28px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 16px;
        }

        .welcome-title {
            font-size: 20px;
            font-weight: 500;
            letter-spacing: -0.01em;
            color: var(--snow);
        }

        .welcome-subtitle {
            font-family: 'JetBrains Mono', monospace;
            font-size: 12px;
            color: var(--muted);
            margin-top: 4px;
        }

        .welcome-actions {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .btn-action-primary {
            background-color: var(--blue);
            color: var(--snow);
            font-family: 'JetBrains Mono', monospace;
            font-size: 12px;
            font-weight: 500;
            padding: 7px 14px;
            border-radius: 3px;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: background-color 0.15s ease;
        }

        .btn-action-primary:hover {
            background-color: var(--blue-hover);
        }

        .btn-action-secondary {
            background-color: var(--void);
            color: var(--snow);
            border: 1px solid var(--edge);
            font-family: 'JetBrains Mono', monospace;
            font-size: 12px;
            padding: 7px 14px;
            border-radius: 3px;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: border-color 0.15s ease, color 0.15s ease;
        }

        .btn-action-secondary:hover {
            border-color: var(--muted);
        }

        /* 2-Column Grid */
        .dashboard-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 28px;
        }

        @media (max-width: 900px) {
            .dashboard-grid {
                grid-template-columns: 1fr;
            }
        }

        .section-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding-bottom: 8px;
            border-bottom: 1px solid var(--edge);
            margin-bottom: 14px;
        }

        .section-title-wrap {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 15px;
            font-weight: 500;
            color: var(--snow);
        }

        .section-count {
            font-family: 'JetBrains Mono', monospace;
            font-size: 12px;
            color: var(--muted);
            font-weight: 400;
        }

        .section-quick-link {
            font-family: 'JetBrains Mono', monospace;
            font-size: 12px;
            color: var(--blue);
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

        .section-quick-link:hover {
            text-decoration: underline;
        }

        /* Cards List */
        .cards-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .item-card {
            background-color: var(--surface);
            border: 1px solid var(--edge);
            border-radius: 4px;
            padding: 14px 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            transition: border-color 0.15s ease, background-color 0.15s ease;
        }

        .item-card:hover {
            border-color: rgba(37, 99, 235, 0.45);
            background-color: var(--surface-elevated);
        }

        .card-info {
            display: flex;
            flex-direction: column;
            gap: 4px;
            min-width: 0;
            flex: 1;
        }

        .card-title-row {
            display: flex;
            align-items: center;
            gap: 8px;
            min-width: 0;
        }

        .card-title-text {
            font-family: 'JetBrains Mono', monospace;
            font-size: 13.5px;
            font-weight: 500;
            color: var(--snow);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .item-card:hover .card-title-text {
            color: var(--blue);
        }

        .card-lang-badge {
            font-family: 'JetBrains Mono', monospace;
            font-size: 10px;
            text-transform: uppercase;
            padding: 1px 6px;
            border: 1px solid var(--edge);
            border-radius: 3px;
            color: var(--muted);
            flex-shrink: 0;
        }

        .card-desc-text {
            font-size: 12px;
            color: var(--muted);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .card-icon-pdf {
            width: 32px;
            height: 32px;
            border-radius: 3px;
            background-color: var(--void);
            border: 1px solid var(--edge);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'JetBrains Mono', monospace;
            font-size: 11px;
            font-weight: 700;
            color: var(--blue);
            flex-shrink: 0;
        }

        .card-actions {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-shrink: 0;
        }

        .card-date {
            font-family: 'JetBrains Mono', monospace;
            font-size: 11px;
            color: var(--muted);
            margin-right: 4px;
        }

        .btn-card-action {
            background-color: var(--void);
            color: var(--snow);
            border: 1px solid var(--edge);
            border-radius: 3px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 11.5px;
            padding: 4px 10px;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            cursor: pointer;
            transition: all 0.15s ease;
        }

        .btn-card-action:hover {
            border-color: var(--blue);
            color: var(--blue);
        }

        .btn-card-rename {
            color: var(--muted);
        }

        .btn-card-rename:hover {
            border-color: var(--muted);
            color: var(--snow);
        }

        .btn-card-delete {
            color: var(--muted);
        }

        .btn-card-delete:hover {
            border-color: rgba(239, 68, 68, 0.4);
            color: var(--danger);
        }

        /* Empty State */
        .empty-state-card {
            border: 1px dashed var(--edge);
            border-radius: 4px;
            padding: 32px 20px;
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
        }

        .empty-state-text {
            font-family: 'JetBrains Mono', monospace;
            font-size: 12px;
            color: var(--muted);
        }

        .empty-state-link {
            font-family: 'JetBrains Mono', monospace;
            font-size: 12px;
            color: var(--blue);
            text-decoration: none;
        }

        .empty-state-link:hover {
            text-decoration: underline;
        }

        /* Footer */
        .dashboard-footer {
            height: 48px;
            border-top: 1px solid var(--edge);
            padding: 0 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-family: 'JetBrains Mono', monospace;
            font-size: 11.5px;
            color: var(--muted);
            margin-top: auto;
        }

        .footer-links {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .footer-link {
            color: var(--muted);
            text-decoration: none;
            transition: color 0.15s ease;
        }

        .footer-link:hover {
            color: var(--snow);
        }

        /* Native Dialog Modals */
        dialog {
            border: none;
            background: transparent;
            margin: auto;
            max-width: 440px;
            width: 100%;
            padding: 16px;
        }

        dialog::backdrop {
            background-color: rgba(0, 0, 0, 0.82);
            backdrop-filter: blur(5px);
        }

        .dialog-card {
            background-color: var(--surface);
            border: 1px solid var(--edge);
            border-radius: 4px;
            padding: 22px 24px;
            box-shadow: 0 24px 48px rgba(0, 0, 0, 0.85);
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .dialog-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding-bottom: 12px;
            border-bottom: 1px solid var(--edge);
        }

        .dialog-title {
            font-family: 'JetBrains Mono', monospace;
            font-size: 14px;
            font-weight: 500;
            color: var(--snow);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .dialog-close-btn {
            background: none;
            border: none;
            color: var(--muted);
            font-size: 18px;
            cursor: pointer;
            padding: 2px;
            line-height: 1;
            transition: color 0.15s ease;
        }

        .dialog-close-btn:hover {
            color: var(--snow);
        }

        .dialog-label {
            display: block;
            font-family: 'JetBrains Mono', monospace;
            font-size: 11.5px;
            color: var(--muted);
            margin-bottom: 6px;
        }

        .dialog-input {
            width: 100%;
            background-color: var(--void);
            border: 1px solid var(--edge);
            border-radius: 3px;
            padding: 8px 12px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 13px;
            color: var(--snow);
            outline: none;
            transition: border-color 0.15s ease;
        }

        .dialog-input:focus {
            border-color: var(--blue);
        }

        .dialog-error {
            font-family: 'JetBrains Mono', monospace;
            font-size: 11.5px;
            color: var(--danger);
            margin-top: 6px;
        }

        .dialog-error.hidden {
            display: none;
        }

        .dialog-actions {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 8px;
            padding-top: 12px;
            border-top: 1px solid var(--edge);
        }

        .btn-dialog-cancel {
            background-color: var(--void);
            color: var(--muted);
            border: 1px solid var(--edge);
            border-radius: 3px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 12px;
            padding: 6px 14px;
            cursor: pointer;
            transition: all 0.15s ease;
        }

        .btn-dialog-cancel:hover {
            border-color: var(--muted);
            color: var(--snow);
        }

        .btn-dialog-save {
            background-color: var(--blue);
            color: var(--snow);
            border: none;
            border-radius: 3px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 12px;
            padding: 6px 14px;
            cursor: pointer;
            transition: background-color 0.15s ease;
        }

        .btn-dialog-save:hover {
            background-color: var(--blue-hover);
        }

        .btn-dialog-danger {
            background-color: var(--danger);
            color: var(--snow);
            border: none;
            border-radius: 3px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 12px;
            padding: 6px 14px;
            cursor: pointer;
            transition: background-color 0.15s ease;
        }

        .btn-dialog-danger:hover {
            background-color: var(--danger-hover);
        }

        /* Toast Container */
        #toastContainer {
            position: fixed;
            bottom: 20px;
            right: 20px;
            z-index: 999;
            display: flex;
            flex-direction: column;
            gap: 8px;
            pointer-events: none;
        }

        /* Focus Ring */
        :focus-visible {
            outline: 2px solid var(--blue);
            outline-offset: 2px;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }

        ::-webkit-scrollbar-track {
            background: var(--void);
        }

        ::-webkit-scrollbar-thumb {
            background: var(--edge);
            border-radius: 3px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: var(--blue);
        }
    </style>
</head>

<body>

    <!-- Top Navigation Bar -->
    <header class="dashboard-header">
        <a href="/" class="header-brand" title="Personal Code Editor Dashboard">
            <i class="ri-terminal-box-line"></i>
            <span>pce/dashboard</span>
        </a>

        <div class="header-controls">
            <a href="/editor" class="btn-launch-editor" title="Launch Code Editor">
                <i class="ri-code-s-slash-line"></i>
                <span>Launch Editor</span>
            </a>
            <div class="header-divider"></div>
            <div class="user-tag">
                <div class="user-tag" title="Active user profile">
                    <i class="ri-user-3-line" style="color:var(--muted)"></i>
                    <span class="user-tag-label">user:</span>
                    <span class="user-tag-name">
                        <%= typeof user !=='undefined' && user && user.username ? user.username.replace(/^user:\s*/i, ''
                            ) : 'Developer' %>
                    </span>
                </div>
                <a href="/login?force=true" id="btn-switch-user" class="btn-card-action btn-card-rename"
                    style="padding:4px 9px; font-size:11px; text-decoration:none;" title="Log in with another account">
                    <i class="ri-user-shared-line"></i>
                    <span>switch user</span>
                </a>
                <div class="header-divider"></div>
                <a href="/logout" id="dashboard-exit-btn" class="btn-header-exit" title="Exit Application">
                    <i class="ri-logout-box-r-line"></i>
                    <span>exit</span>
                </a>
            </div>
    </header>

    <!-- Main Content Area -->
    <main class="dashboard-main">

        <!-- Welcome Banner -->
        <section class="welcome-card">
            <div>
                <h1 class="welcome-title">
                    Welcome, <%= typeof user !=='undefined' && user && user.username ?
                        user.username.replace(/^user:\s*/i, '' ) : 'Developer' %>
                </h1>
                <p class="welcome-subtitle">
                    Manage your saved project workspaces and exported documentation.
                </p>
            </div>
            <div class="welcome-actions">
                <a href="/editor" class="btn-action-primary" title="Create New Workspace">
                    <i class="ri-add-line"></i>
                    <span>New Workspace</span>
                </a>
                <a href="/aboutCodeEditor" class="btn-action-secondary" title="Documentation & Features">
                    <i class="ri-book-open-line"></i>
                    <span>Docs</span>
                </a>
            </div>
        </section>

        <!-- Workspaces & PDFs 2-Column Grid -->
        <div class="dashboard-grid">

            <!-- Workspaces Section -->
            <section class="section-container">
                <div class="section-header">
                    <h2 class="section-title-wrap">
                        <i class="ri-folder-cloud-line" style="color:var(--blue)"></i>
                        <span>Workspaces</span>
                        <span id="workspaces-count" class="section-count">(<%= typeof projects !=='undefined' ?
                                projects.length : 0 %>)</span>
                    </h2>
                    <a href="/editor" class="section-quick-link" title="Create workspace">+ new</a>
                </div>

                <div class="cards-list" id="workspaces-list">
                    <% if (typeof projects !=='undefined' && projects.length> 0) { %>
                        <% projects.forEach(project=> { %>
                            <div id="project-card-<%= project._id %>" data-id="<%= project._id %>" data-type="project"
                                class="group item-card">
                                <div class="card-info">
                                    <div class="card-title-row">
                                        <i class="ri-folder-line"
                                            style="color:#6b7280; font-size:14px; flex-shrink:0;"></i>
                                        <span class="card-title-text project-name-text">
                                            <%= project.projectName %>
                                        </span>
                                        <% if (project.projectProgrammingLanguage) { %>
                                            <span class="card-lang-badge">
                                                <%= project.projectProgrammingLanguage %>
                                            </span>
                                            <% } %>
                                    </div>
                                    <% if (project.projectDescription && project.projectDescription
                                        !=='No description provided' ) { %>
                                        <p class="card-desc-text project-desc-text">
                                            <%= project.projectDescription %>
                                        </p>
                                        <% } %>
                                </div>
                                <div class="card-actions">
                                    <span class="hidden sm:inline card-date">
                                        <%= new Date(project.createdAt).toLocaleDateString(undefined, { month: 'short' ,
                                            day: 'numeric' }) %>
                                    </span>
                                    <a href="/editor?projectUrl=<%= encodeURIComponent(project.projectUrl) %>&name=<%= encodeURIComponent(project.projectName) %>"
                                        class="btn-card-action project-open-link" data-url="<%= project.projectUrl %>"
                                        title="Open in Code Editor">
                                        <i class="ri-arrow-right-up-line"></i>
                                        <span>open</span>
                                    </a>
                                    <button type="button" class="btn-card-action btn-card-rename btn-rename"
                                        data-id="<%= project._id %>" data-type="project"
                                        data-name="<%= project.projectName %>" title="Rename workspace">
                                        rename
                                    </button>
                                    <button type="button" class="btn-card-action btn-card-delete btn-delete"
                                        data-id="<%= project._id %>" data-type="project"
                                        data-name="<%= project.projectName %>" title="Delete workspace">
                                        delete
                                    </button>
                                </div>
                            </div>
                            <% }) %>
                                <% } else { %>
                                    <div id="workspaces-empty-state" class="empty-state-card">
                                        <i class="ri-folder-open-line" style="font-size:24px; color:var(--muted)"></i>
                                        <p class="empty-state-text">No workspaces saved yet.</p>
                                        <a href="/editor" class="empty-state-link">+ Create in editor</a>
                                    </div>
                                    <% } %>
                </div>
            </section>

            <!-- PDF Documents Section -->
            <section class="section-container">
                <div class="section-header">
                    <h2 class="section-title-wrap">
                        <i class="ri-file-pdf-line" style="color:var(--blue)"></i>
                        <span>Exports & Documentation</span>
                        <span id="pdfs-count" class="section-count">(<%= typeof pdfs !=='undefined' ? pdfs.length : 0 %>
                                )</span>
                    </h2>
                </div>

                <div class="cards-list" id="pdfs-list">
                    <% if (typeof pdfs !=='undefined' && pdfs.length> 0) { %>
                        <% pdfs.forEach(pdf=> { %>
                            <div id="pdf-card-<%= pdf._id %>" data-id="<%= pdf._id %>" data-type="pdf"
                                class="group item-card">
                                <div class="card-info" style="flex-direction:row; align-items:center; gap:12px;">
                                    <div class="card-icon-pdf">
                                        PDF
                                    </div>
                                    <div style="min-width:0; flex:1;">
                                        <p class="card-title-text pdf-name-text">
                                            <%= pdf.pdfName %>
                                        </p>
                                        <p
                                            style="font-family:'JetBrains Mono',monospace; font-size:11px; color:var(--muted);">
                                            <%= new Date(pdf.createdAt).toLocaleDateString(undefined, { year: 'numeric'
                                                , month: 'short' , day: 'numeric' }) %>
                                        </p>
                                    </div>
                                </div>

                                <div class="card-actions">
                                    <a href="<%= pdf.pdfUrl %>" target="_blank" rel="noopener noreferrer"
                                        class="btn-card-action" title="View PDF">
                                        <i class="ri-eye-line"></i>
                                        <span>view</span>
                                    </a>
                                    <button type="button" class="btn-card-action btn-card-rename btn-rename"
                                        data-id="<%= pdf._id %>" data-type="pdf" data-name="<%= pdf.pdfName %>"
                                        title="Rename document">
                                        rename
                                    </button>
                                    <button type="button" class="btn-card-action btn-card-delete btn-delete"
                                        data-id="<%= pdf._id %>" data-type="pdf" data-name="<%= pdf.pdfName %>"
                                        title="Delete document">
                                        delete
                                    </button>
                                </div>
                            </div>
                            <% }) %>
                                <% } else { %>
                                    <div id="pdfs-empty-state" class="empty-state-card">
                                        <i class="ri-file-text-line" style="font-size:24px; color:var(--muted)"></i>
                                        <p class="empty-state-text">No exports generated yet.</p>
                                        <span
                                            style="font-family:'JetBrains Mono',monospace; font-size:11px; color:var(--muted);">
                                            Export code to PDF from the editor toolbar.
                                        </span>
                                    </div>
                                    <% } %>
                </div>
            </section>

        </div>

    </main>

    <!-- Footer -->
    <footer class="dashboard-footer">
        <span>personal_code_editor // dashboard</span>
        <div class="footer-links">
            <a href="/aboutCodeEditor" class="footer-link">about</a>
            <a href="/editor" class="footer-link">editor</a>
            <a href="/login" class="footer-link">account</a>
        </div>
    </footer>

    <!-- Rename Modal -->
    <dialog id="renameDialog">
        <div class="dialog-card">
            <div class="dialog-header">
                <h3 id="renameDialogTitle" class="dialog-title">
                    <i class="ri-edit-line"></i>
                    <span>Rename Workspace</span>
                </h3>
                <button type="button" id="closeRenameDialogBtn" class="dialog-close-btn"
                    aria-label="Close dialog">&times;</button>
            </div>
            <form id="renameForm" style="display:flex; flex-direction:column; gap:12px;">
                <input type="hidden" id="renameItemId">
                <input type="hidden" id="renameItemType">
                <div>
                    <label for="renameInput" class="dialog-label">New Name</label>
                    <input type="text" id="renameInput" maxlength="100" required autocomplete="off" class="dialog-input"
                        placeholder="Enter new name">
                    <p id="renameError" class="hidden dialog-error"></p>
                </div>
                <div class="dialog-actions">
                    <button type="button" id="cancelRenameBtn" class="btn-dialog-cancel">
                        Cancel
                    </button>
                    <button type="submit" id="saveRenameBtn" class="btn-dialog-save">
                        Save Changes
                    </button>
                </div>
            </form>
        </div>
    </dialog>

    <!-- Delete Confirmation Modal -->
    <dialog id="deleteDialog">
        <div class="dialog-card">
            <div class="dialog-header">
                <h3 id="deleteDialogTitle" class="dialog-title" style="color:var(--danger)">
                    <i class="ri-delete-bin-line"></i>
                    <span>Confirm Deletion</span>
                </h3>
                <button type="button" id="closeDeleteDialogBtn" class="dialog-close-btn"
                    aria-label="Close dialog">&times;</button>
            </div>
            <div style="display:flex; flex-direction:column; gap:8px;">
                <p style="font-size:13px; color:var(--muted); line-height:1.5;">
                    Are you sure you want to permanently delete <span id="deleteItemName"
                        style="font-family:'JetBrains Mono',monospace; color:var(--snow); font-weight:500;"></span>?
                </p>
                <p style="font-family:'JetBrains Mono',monospace; font-size:11px; color:rgba(239,68,68,0.85);">
                    This action is permanent and will delete the item and its stored file.
                </p>
                <p id="deleteError" class="hidden dialog-error"></p>
            </div>
            <div class="dialog-actions">
                <button type="button" id="cancelDeleteBtn" class="btn-dialog-cancel">
                    Cancel
                </button>
                <button type="button" id="confirmDeleteBtn" class="btn-dialog-danger">
                    Delete Permanently
                </button>
            </div>
        </div>
    </dialog>



    <!-- Toast Notification Container -->
    <div id="toastContainer" aria-live="polite"></div>

    <script src="/dashboard.js" defer></script>
</body>

</html>