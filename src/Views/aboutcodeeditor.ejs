    <!-- Interactive Inspector Script -->
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const tabButtons = document.querySelectorAll(".interactive-tab-btn");
            const contentPanes = document.querySelectorAll(".arch-content");

            tabButtons.forEach(btn => {
                btn.addEventListener("click", () => {
                    const target = btn.getAttribute("data-target");

                    // Reset buttons
                    tabButtons.forEach(b => {
                        b.classList.remove("active");
                        const icon = b.querySelector("i");
                        if (icon) icon.className = icon.className.replace("text-blue", "text-muted");
                    });

                    // Activate clicked button
                    btn.classList.add("active");
                    const activeIcon = btn.querySelector("i");
                    if (activeIcon) activeIcon.className = activeIcon.className.replace("text-muted", "text-blue");

                    // Hide all panes
                    contentPanes.forEach(pane => pane.classList.add("hidden"));

                    // Show active pane
                    const activePane = document.getElementById("pane-" + target);
                    if (activePane) activePane.classList.remove("hidden");
                });
            });
        });
    </script>
