(// Basic function with type annotations) Tj
T* (function greet\(name: string\): string {) Tj
T* (  return `Hello, ${name}!`;) Tj
T* (}) Tj
T* () Tj
T* (// Arrow function with explicit return type) Tj
T* (const add = \(a: number, b: number\): number => {) Tj
T* (  return a + b;) Tj
T* (};) Tj
T* () Tj
T* (// Function with optional parameter) Tj
T* (function greetOptional\(name: string, greeting?: string\): string {) Tj
T* (  const g = greeting ?? "Hello";) Tj
T* (  return `${g}, ${name}!`;) Tj
T* (}) Tj
T* () Tj
T* (// Function with default parameter) Tj
T* (function greetDefault\(name: string, greeting = "Hi"\): string {) Tj
T* (  return `${greeting}, ${name}!`;) Tj
T* (}) Tj
T* () Tj
T* (// Function with rest parameters) Tj
T* (function sum\(...numbers: number[]\): number {) Tj
T* (  return numbers.reduce\(\(acc, n\) => acc + n, 0\);) Tj
T* (}) Tj
T* () Tj
T* (// Generic function) Tj
T* (function identity<T>\(value: T\): T {) Tj
T* (  return value;) Tj
T* (}) Tj
T* () Tj
T* (// Function type as a type alias) Tj
T* (type MathOperation = \(a: number, b: number\) => number;) Tj
T* () Tj
T* (const multiply: MathOperation = \(a, b\) => a * b;) Tj
T* (const divide: MathOperation = \(a, b\) => a / b;) Tj
T* () Tj
T* (// Higher-order function) Tj
T* (function applyOperation\(a: number, b: number, op: MathOperation\): number {) Tj
T* (  return op\(a, b\);) Tj
T* (}) Tj
T* () Tj
T* (// Async function) Tj
T* (async function fetchUser\(id: number\): Promise<{ id: number; name: string }> {) Tj
T* (  // Simulated async operation) Tj
T* (  return { id, name: `User ${id}` };) Tj
T* (}) Tj
T* () Tj
T* (// Usage examples) Tj
T* (console.log\(greet\("Alice"\)\);                    // "Hello, Alice!") Tj
T* (console.log\(add\(5, 3\)\);                         // 8) Tj
T* (console.log\(greetOptional\("Bob"\)\);              // "Hello, Bob!") Tj
T* (console.log\(greetOptional\("Bob", "Hey"\)\);       // "Hey, Bob!") Tj
T* (console.log\(greetDefault\("Carol"\)\);             // "Hi, Carol!") Tj
T* (console.log\(sum\(1, 2, 3, 4, 5\)\);                // 15) Tj
T* (console.log\(identity<string>\("test"\)\);          // "test") Tj
T* (console.log\(identity\(42\)\);                      // 42) Tj
T* (console.log\(applyOperation\(10, 5, multiply\)\);   // 50) Tj
T* (console.log\(applyOperation\(10, 5, divide\)\);     // 2) Tj
